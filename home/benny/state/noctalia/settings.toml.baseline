config_version = 16

[bar.default]
background_opacity = 0.60999998636543751
capsule = true
capsule_opacity = 0.74999998323619366
capsule_thickness = 0.79999998584389687
end = [
    "tray",
    "bar",
    "nix-monitor",
    "notifications",
    "clipboard",
    "network",
    "bluetooth",
    "status",
    "volume",
    "brightness",
    "battery",
    "control-center",
    "session"
]
start = [ "launcher", "wallpaper", "wallhaven", "launcher_2", "workspaces", "active_window", "media" ]

[calendar]
enabled = true

    [calendar.account.personal_google]
    type = "google"

[[control_center.shortcuts]]
type = "wifi"

[[control_center.shortcuts]]
type = "bluetooth"

[[control_center.shortcuts]]
type = "caffeine"

[[control_center.shortcuts]]
type = "notification"

[[control_center.shortcuts]]
type = "power_profile"

[dock]
background_opacity = 0.79999998211860657
enabled = true
icon_size = 36
margin_edge = 0
pinned = [ "firefox", "io.github.kolunmi.Bazaar", "org.vinegarhq.Sober", "org.vinegarhq.Vinegar" ]
reserve_space = false
smart_auto_hide = true

[hot_corners.top_left]
action = "command"
command = "umbriel msg overview-open"

[idle]
behavior_order = [ "lock", "screen-off", "lock-and-suspend" ]

    [idle.behavior.lock]
    action = "lock"
    enabled = true
    timeout = 600.0

    [idle.behavior.lock-and-suspend]
    action = "lock_and_suspend"
    enabled = true
    timeout = 900.0

    [idle.behavior.screen-off]
    action = "screen_off"
    enabled = true
    timeout = 660.0

[location]
address = "Barsinghausen"
auto_locate = true

[lockscreen]
blur_intensity = 0.5
blurred_desktop = true
enabled = true
tint_intensity = 0.20000000000000001

[lockscreen_widgets]
enabled = true
schema_version = 2
widget_order = [
    "lockscreen-login-box@VGA-1",
    "lockscreen-login-box@HDMI-A-3",
    "lockscreen-login-box@HDMI-A-1",
    "lockscreen-widget-0000000000000001",
    "lockscreen-widget-0000000000000003"
]

    [lockscreen_widgets.grid]
    cell_size = 16
    major_interval = 4
    visible = true

    [lockscreen_widgets.widget."lockscreen-login-box@HDMI-A-1"]
    box_height = 196.0
    box_width = 810.0
    cx = 960.0
    cy = 898.0
    output = "HDMI-A-1"
    placement_height = 1080.0
    placement_width = 1920.0
    rotation = 0.0
    type = "login_box"

        [lockscreen_widgets.widget."lockscreen-login-box@HDMI-A-1".settings]
        background_color = "surface_container"
        background_opacity = 0.88
        background_radius = 12.0
        center_password_text = false
        input_opacity = 1.0
        input_radius = 6.0
        layout = "regular"
        show_caps_lock = true
        show_keyboard_layout = true
        show_login_button = true
        show_media = true
        show_session_buttons = true
        show_unlock_hint = true
        show_weather = true

    [lockscreen_widgets.widget."lockscreen-login-box@HDMI-A-3"]
    box_height = 196.0
    box_width = 810.0
    cx = 960.0
    cy = 898.0
    output = "HDMI-A-3"
    placement_height = 1080.0
    placement_width = 1920.0
    rotation = 0.0
    type = "login_box"

        [lockscreen_widgets.widget."lockscreen-login-box@HDMI-A-3".settings]
        background_color = "surface_container"
        background_opacity = 0.88
        background_radius = 12.0
        center_password_text = false
        input_opacity = 1.0
        input_radius = 6.0
        layout = "regular"
        show_caps_lock = true
        show_keyboard_layout = true
        show_login_button = true
        show_media = true
        show_session_buttons = true
        show_unlock_hint = true
        show_weather = true

    [lockscreen_widgets.widget."lockscreen-login-box@VGA-1"]
    box_height = 196.0
    box_width = 810.0
    cx = 960.0
    cy = 898.0
    output = "VGA-1"
    placement_height = 1080.0
    placement_width = 1920.0
    rotation = 0.0
    type = "login_box"

        [lockscreen_widgets.widget."lockscreen-login-box@VGA-1".settings]
        background_color = "surface_container"
        background_opacity = 0.88
        background_radius = 12.0
        center_password_text = false
        input_opacity = 1.0
        input_radius = 6.0
        layout = "regular"
        show_caps_lock = true
        show_keyboard_layout = true
        show_login_button = true
        show_media = true
        show_session_buttons = true
        show_unlock_hint = true
        show_weather = true

    [lockscreen_widgets.widget.lockscreen-widget-0000000000000001]
    box_height = 260.0
    box_width = 800.0
    cx = 960.0
    cy = 280.0
    output = "HDMI-A-1"
    placement_height = 1080.0
    placement_width = 1920.0
    rotation = 0.0
    type = "clock"

        [lockscreen_widgets.widget.lockscreen-widget-0000000000000001.settings]
        background_opacity = 0.0
        center_text = true
        clock_style = "minimal"
        color = "#FFFFFF"
        font_family = "TeX Gyre Pagella"
        format = """{:%H:%M}
{:%A, %d. %B}"""
        shadow = true

    [lockscreen_widgets.widget.lockscreen-widget-0000000000000003]
    box_height = 180.0
    box_width = 720.0
    cx = 960.0
    cy = 580.0
    output = "HDMI-A-1"
    placement_height = 1080.0
    placement_width = 1920.0
    rotation = 0.0
    type = "media_player"

        [lockscreen_widgets.widget.lockscreen-widget-0000000000000003.settings]
        background_opacity = 0.0
        color = "#FFFFFF"
        font_family = "TeX Gyre Pagella"
        hide_when_no_media = true
        layout = "horizontal"
        shadow = true

[notification]
layer = "overlay"

[plugin_settings."alexander/game-launcher"]
steampoacher_enabled = true

[plugin_settings."aristides/udiskie"]
auto_open_filemanager = true
file_manager_cmd = "thunar"

[plugin_settings."avivbintangaringga/nix-monitor"]
update_command = "cd /etc/nixos && nix flake update && sudo nixos-rebuild switch --flake /etc/nixos#benny"

[plugin_settings."raycursive/discord-voice"]
discord_binary = "/etc/profiles/per-user/benny/bin/discord"

[plugins]
enabled = [ "avivbintangaringga/nix-monitor", "aristides/udiskie", "noctalia/wallhaven", "raycursive/discord-voice" ]

    [[plugins.source]]
    auto_update = true
    kind = "git"
    location = "https://github.com/noctalia-dev/official-plugins"
    name = "official"

    [[plugins.source]]
    auto_update = true
    kind = "git"
    location = "https://github.com/noctalia-dev/community-plugins"
    name = "community"

[shell]
font_family = "Comic Sans MS"
launch_apps_as_systemd_services = true
password_style = "random"
polkit_agent = true
settings_show_advanced = true

    [shell.greeter_sync]
    auto_sync = true
    privilege_command = "pkexec"

    [shell.launcher]
    pinned = [ "io.github.kolunmi.Bazaar" ]

    [shell.screenshot]
    directory = "/home/benny/Bilder/Screenshots"
    show_cursor = true

[theme]
builtin = "Noctalia"
community_palette = "Zenbones"
mode = "dark"
pure_black_dark = true
shell_mode = "dark"
source = "wallpaper"
wallpaper_scheme = "m3-rainbow"

    [theme.templates]
    builtin_ids = [ "gtk3", "gtk4", "qt", "umbriel" ]

[wallpaper]
transition = []
transition_duration = 2200
transition_on_startup = true

    [wallpaper.automation]
    interval_seconds = 40

    [wallpaper.default]
    path = "/home/benny/Pictures/wallhaven-dgezrg.jpg"

    [wallpaper.last]
    path = "/home/benny/Pictures/wallhaven-dgezrg.jpg"

    [wallpaper.monitors.HDMI-A-1]
