[weather]
effects = true
enabled = true
refresh_minutes = 15
unit = "celsius"

[widget.bar]
type = "raycursive/discord-voice:bar"

[widget.battery]
show_label = false

[widget.brightness]
show_label = false

[widget.clock]
format = "{:%H:%M} -- {:%d.%m.%y}"

[widget.launcher_2]
type = "alexander/game-launcher:launcher"

[widget.network]
show_label = false

[widget.nix-monitor]
show_text = false
type = "avivbintangaringga/nix-monitor:nix-monitor"

[widget.status]
type = "aristides/udiskie:status"

[widget.volume]
show_label = false

[widget.wallhaven]
type = "noctalia/wallhaven:wallhaven"