layout {

    focus-ring {
        active-color   "#84532f"
        inactive-color "#fff8f5"
        urgent-color   "#ba1a1a"
    }

    border {
        active-color   "#84532f"
        inactive-color "#fff8f5"
        urgent-color   "#ba1a1a"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#84532f"
        inactive-color "#c78c64"
        urgent-color   "#ba1a1a"
    }

    insert-hint {
        color "#84532f80"
    }
}

recent-windows {
    highlight {
        active-color "#84532f"
        urgent-color "#ba1a1a"
    }
}
