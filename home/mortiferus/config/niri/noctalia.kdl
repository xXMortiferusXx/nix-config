layout {

    focus-ring {
        active-color   "#7b5733"
        inactive-color "#fff8f5"
        urgent-color   "#ba1a1a"
    }

    border {
        active-color   "#7b5733"
        inactive-color "#fff8f5"
        urgent-color   "#ba1a1a"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#7b5733"
        inactive-color "#e7b88d"
        urgent-color   "#ba1a1a"
    }

    insert-hint {
        color "#7b573380"
    }
}

recent-windows {
    highlight {
        active-color "#7b5733"
        urgent-color "#ba1a1a"
    }
}
