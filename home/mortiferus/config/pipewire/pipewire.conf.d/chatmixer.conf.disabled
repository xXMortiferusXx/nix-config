# /home/mortiferus/.config/pipewire/pipewire.conf.d/chatmixer.conf
# Saubere Sinks ohne Atmos/Convolver (2026-08-16):
# GameSink (8 Kanäle) + ChatSink (Stereo) als reine Loopbacks direkt aufs Headset.

context.modules = [
    # 1. GAME SINK 7.1 (Loopback, damit Spiele 8 Kanäle sehen)
    # Separate Spiele-Lautstärke + Routing unabhängig vom Default-Device
    { name = libpipewire-module-loopback
      args = {
          node.description = "Game Audio"
          capture.props = {
              node.name = "GameSink"
              media.class = "Audio/Sink"
              audio.channels = 8
              audio.position = [ FL FR FC LFE RL RR SL SR ]
          }
          playback.props = {
              node.target = "alsa_output.atlas_air_headset"
              node.passive = true
          }
      }
    }

    # 2. CHAT SINK (sauber, Stereo, direkt ans Headset)
    { name = libpipewire-module-loopback
      args = {
          node.description = "Chat Audio"
          capture.props = {
              node.name = "ChatSink"
              media.class = "Audio/Sink"
              audio.channels = 2
              audio.position = [ FL FR ]
          }
          playback.props = {
              node.target = "alsa_output.atlas_air_headset"
              node.passive = true
          }
      }
    }
]
